# Atelier Yumia Translation Toolkit - Environment Variables
# Copy or rename this file to .env and configure your keys:

# OpenAI / ChatGPT API Key (Required for cloud translation)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Configurations:
# OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# WORKERS=15
